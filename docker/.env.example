# Quest Agent SDK Configuration

# OpenAI API Key (required for LangChain examples)
OPENAI_API_KEY=your-openai-api-key-here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Quest Agent Forge API
API_URL=http://localhost:3000
API_KEY=

# Document Path (for RAG agent)
DOCUMENTS_PATH=./documents

# Agent Configuration
AGENT_NAME=My Custom Agent
AGENT_VERSION=1.0.0
